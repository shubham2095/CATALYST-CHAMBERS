# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is gitignored and must never be committed.

# development locally, production on Hostinger
NODE_ENV=development

# Port the Express server listens on
PORT=5000

# Public address of the website (no trailing slash). Used for the sitemap.
SITE_URL=http://localhost:5000

# Gmail address that will SEND the enquiry emails
EMAIL_USER=your-gmail@gmail.com

# Gmail App Password (NOT your normal Gmail password) for EMAIL_USER
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step Verification)
EMAIL_PASS=your-gmail-app-password

# Address(es) that should RECEIVE enquiry emails, comma-separated for multiple
EMAIL_TO=recipient1@example.com,recipient2@example.com

# ---- Admin panel (/admin) ----
# Email you log in to the admin with
ADMIN_EMAIL=owner@example.com

# bcrypt hash of your admin password. Generate it with: npm run hash-password
# Keep the single quotes in your local .env (the hash contains $ characters).
# On Hostinger paste the hash WITHOUT the quotes.
ADMIN_PASSWORD_HASH='paste-the-hash-here'

# Long random secret used to sign login cookies (min 32 characters).
# `npm run hash-password` prints one for you.
JWT_SECRET=replace-with-a-long-random-string

# How long a login lasts (e.g. 8h, 1d)
JWT_EXPIRES_IN=8h

# Set to true once the site runs on https (Hostinger live site). Keep false for http://localhost.
COOKIE_SECURE=false

# Folder where the live website content (JSON files edited from the admin) is stored.
# Locally this can stay as is. On Hostinger set it to a folder OUTSIDE the deployed app
# folder (e.g. /home/<your-user>/catalyst-data/content) so redeploys never overwrite edits.
CONTENT_DIR=./storage/content

# Folder where images uploaded from the admin are stored. Same rule as CONTENT_DIR:
# on Hostinger use a folder OUTSIDE the deployed app (e.g. /home/<your-user>/catalyst-data/uploads).
UPLOAD_DIR=./storage/uploads
