# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is gitignored and must never be committed.

# Port the Express server listens on
PORT=5000

# Gmail address that will SEND the enquiry emails
EMAIL_USER=your-gmail@gmail.com

# Gmail App Password (NOT your normal Gmail password) for EMAIL_USER
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step Verification)
EMAIL_PASS=your-gmail-app-password

# Address(es) that should RECEIVE enquiry emails, comma-separated for multiple
EMAIL_TO=recipient1@example.com,recipient2@example.com

# Folder where the live website content (JSON files edited from the admin) is stored.
# Locally this can stay as is. On Hostinger set it to a folder OUTSIDE the deployed app
# folder (e.g. /home/<your-user>/catalyst-data/content) so redeploys never overwrite edits.
CONTENT_DIR=./storage/content
